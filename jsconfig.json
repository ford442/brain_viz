{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
