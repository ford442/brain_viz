{
  "name": "brain_viz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node tests/test_uniform_layout.js && node tests/test_shader.js && node tests/test_wgsl_naga.js && node tests/test_tensor_physics.js && node tests/test_voxel_dim.js && node tests/test_live_input_bus.js && node tests/test_clipmap.js && node tests/test_wasm_engine.js && npm run check:facade",
    "test:golden": "bash scripts/test_golden.sh",
    "test:all": "npm test && npm run test:golden",
    "test:wgsl": "node scripts/wgsl_oracle.mjs",
    "check:facade": "node scripts/check-renderer-facade.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "lint": "eslint src",
    "gen:wasm-params": "node scripts/gen_wasm_params.mjs",
    "gen:tensor-fixture": "node scripts/gen_tensor_fixture.mjs",
    "gen:compile-commands": "node scripts/gen_compile_commands.mjs",
    "gen:compile-commands:wasm": "node scripts/gen_compile_commands.mjs --emscripten",
    "prebuild": "bash scripts/check_wasm.sh",
    "build": "npm run build:web",
    "build:web": "vite build",
    "build:full": "npm run build:wasm && vite build",
    "build_colab": "npm run build:wasm_colab && vite build",
    "preview": "vite preview",
    "build:wasm": "bash scripts/build_wasm.sh",
    "build:wasm_colab": "bash scripts/build_wasm_colab.sh",
    "build:wasm:debug": "bash scripts/build_wasm.sh --debug",
    "bench:wasm": "bash scripts/bench_wasm.sh",
    "bci:bridge": "node scripts/openbci_ws_bridge.mjs",
    "deploy": "python deploy.py"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@webgpu/types": "^0.1.72",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^63.3.3",
    "globals": "^17.13.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "marked": "^17.0.4",
    "onnxruntime-web": "^1.23.2",
    "playwright": "^1.58.2",
    "ws": "^8.18.3"
  }
}
